# Copy to .env. Origin of the Django API (no trailing slash, no /api path).
# Use localhost, not 127.0.0.1: the app runs on localhost:3000, and the refresh
# cookie is only sent to an API on the same site.
VITE_API_BASE_URL=http://localhost:8000

# Optional: report errors to a Sentry-compatible service (off while empty).
# VITE_SENTRY_DSN=
