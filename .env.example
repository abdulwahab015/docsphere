# DEBUG is set by the settings module (core.settings.local / .production), not read
# from here. DJANGO_SETTINGS_MODULE defaults to core.settings.local; deployments set
# DJANGO_SETTINGS_MODULE=core.settings.production explicitly.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Only read by core.settings.production. Ramp this up over time as you verify
# HTTPS is stable everywhere — don't jump straight to a long value (e.g. one
# year: 31536000); start small (e.g. 3600) and increase once confirmed safe.
SECURE_HSTS_SECONDS=3600

DATABASE_URL=sqlite:///db.sqlite3

POSTGRES_DB=docsphere
POSTGRES_USER=docsphere
POSTGRES_PASSWORD=change-me

STRIPE_LIVE_MODE=False
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_TEST_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_LIVE_PUBLIC_KEY=pk_live_your_live_public_key
DJSTRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=DocSphere <no-reply@docsphere.com>

FRONTEND_URL=http://localhost:3000

# Comma-separated exact origins allowed to call the API from a browser.
# Defaults to FRONTEND_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
INVITATION_EXPIRY_SECONDS=604800

# DRF throttle rates ("<count>/<second|minute|hour|day>"). anon/user are the
# global baseline; the rest are tighter scoped limits on sensitive endpoints.
ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=1000/min
LOGIN_THROTTLE_RATE=10/min
INVITE_ACCEPT_THROTTLE_RATE=10/min
PASSWORD_RESET_THROTTLE_RATE=5/hour

# Move the Django admin off /admin/ in production (and IP-restrict it upstream).
# DJANGO_ADMIN_PATH=some-random-prefix/

# Only used by docker-compose.yml's redis service and to build the
# CELERY_BROKER_URL/CELERY_RESULT_BACKEND used there (redis://:$REDIS_PASSWORD@redis:6379/0).
# Bare local dev (no docker) doesn't need this — CELERY_BROKER_URL below has
# no auth since it targets localhost, not the compose-managed redis.
REDIS_PASSWORD=change-me

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Flower dashboard auth, "user:password" (basic auth — only put Flower behind
# TLS if its port is ever published). Read only by the flower process.
FLOWER_BASIC_AUTH=admin:REPLACE_WITH_A_STRONG_PASSWORD

# Optional logging overrides (sensible in-code defaults exist).
# CORE_LOG_LEVEL=INFO
# MAX_LOG_BODY_CHARS=2048
