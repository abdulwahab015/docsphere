SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_HSTS_SECONDS=3600

DATABASE_URL=sqlite:///db.sqlite3

POSTGRES_DB=docsphere
POSTGRES_USER=docsphere
POSTGRES_PASSWORD=change-me

STRIPE_LIVE_MODE=False
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_TEST_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_LIVE_PUBLIC_KEY=pk_live_your_live_public_key
# The Stripe product (prod_...) whose recurring prices are offered as plans.
STRIPE_PRODUCT_ID=prod_your_product_id

# Production sends email through this SMTP server. Locally, emails are printed
# in the `make run` terminal instead, unless EMAIL_BACKEND says otherwise.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=DocSphere <no-reply@docsphere.com>

# Where emailed links and Stripe's return addresses point. In production the
# app and the API share one origin (the `frontend` service's nginx forwards the
# API to Django), e.g. https://docsphere.example.com: set FRONTEND_URL and
# CORS_ALLOWED_ORIGINS to it and ALLOWED_HOSTS to its hostname.
FRONTEND_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host port the `frontend` service publishes (docker compose); the load
# balancer forwards to it.
# APP_PORT=8080

# On a server deployed by the Deploy workflow: the published images it runs,
# e.g. ghcr.io/<owner>/docsphere-backend. IMAGE_TAG (the release's commit) is
# written by scripts/deploy.sh. Unset, `docker compose up --build` builds
# both images here.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
# IMAGE_TAG=

# gunicorn in the `web` service (docker compose): worker processes, and how
# long a request may take before its worker is restarted.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT_SECONDS=30

# The `backup` service: how often it dumps the database, and how many days of
# dumps it keeps.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14

ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
INVITATION_EXPIRY_SECONDS=604800
EMAIL_LINK_EXPIRY_SECONDS=86400
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=7

ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=1000/min
LOGIN_THROTTLE_RATE=10/min
TWO_FACTOR_LOGIN_THROTTLE_RATE=5/min
INVITE_ACCEPT_THROTTLE_RATE=10/min
PASSWORD_RESET_THROTTLE_RATE=5/hour
BILLING_CHECKOUT_THROTTLE_RATE=10/min
BILLING_PORTAL_THROTTLE_RATE=10/min
ORG_SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_CHANGE_THROTTLE_RATE=5/hour
EMAIL_VERIFICATION_THROTTLE_RATE=10/hour
EMAIL_CHANGE_THROTTLE_RATE=5/hour
# Counted per organization, whichever admin asks.
ORGANIZATION_EXPORT_THROTTLE_RATE=5/day

# "Lax" when the SPA and API share a site - always so behind the `frontend`
# service; "None" (HTTPS only) for an API on another site.
# REFRESH_COOKIE_SAMESITE=Lax

# DJANGO_ADMIN_PATH=some-random-prefix/

REDIS_PASSWORD=change-me

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

FLOWER_BASIC_AUTH=admin:REPLACE_WITH_A_STRONG_PASSWORD

# CORE_LOG_LEVEL=INFO
# MAX_LOG_BODY_CHARS=2048

# Error tracking with a Sentry-compatible service (Sentry, or a self-hosted
# GlitchTip); off while the DSNs are empty. Reports carry user and organization
# ids only, and the release (the commit the images were built from).
# SENTRY_FRONTEND_DSN is handed to the browser app when it's served; the app
# sends its reports to SENTRY_INGEST_ORIGIN (e.g. https://o123.ingest.sentry.io)
# - its content security policy allows that origin and no other. Name each
# server's SENTRY_ENVIRONMENT (staging, production).
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=
# SENTRY_INGEST_ORIGIN=
# SENTRY_ENVIRONMENT=production
