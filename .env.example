SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_HSTS_SECONDS=3600

DATABASE_URL=sqlite:///db.sqlite3

POSTGRES_DB=docsphere
POSTGRES_USER=docsphere
POSTGRES_PASSWORD=change-me

STRIPE_LIVE_MODE=False
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_TEST_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_LIVE_PUBLIC_KEY=pk_live_your_live_public_key
# The Stripe product (prod_...) whose recurring prices are offered as plans.
STRIPE_PRODUCT_ID=prod_your_product_id

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=DocSphere <no-reply@docsphere.com>

# Where emailed links and Stripe's return addresses point. In production the
# app and the API share one origin (the `frontend` service's nginx forwards the
# API to Django), e.g. https://docsphere.example.com: set FRONTEND_URL and
# CORS_ALLOWED_ORIGINS to it and ALLOWED_HOSTS to its hostname.
FRONTEND_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host port the `frontend` service publishes (docker compose); the load
# balancer forwards to it.
# APP_PORT=8080

ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
INVITATION_EXPIRY_SECONDS=604800
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=7

ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=1000/min
LOGIN_THROTTLE_RATE=10/min
INVITE_ACCEPT_THROTTLE_RATE=10/min
PASSWORD_RESET_THROTTLE_RATE=5/hour
BILLING_CHECKOUT_THROTTLE_RATE=10/min
BILLING_PORTAL_THROTTLE_RATE=10/min
ORG_SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_CHANGE_THROTTLE_RATE=5/hour

# "Lax" when the SPA and API share a site - always so behind the `frontend`
# service; "None" (HTTPS only) for an API on another site.
# REFRESH_COOKIE_SAMESITE=Lax

# DJANGO_ADMIN_PATH=some-random-prefix/

REDIS_PASSWORD=change-me

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

FLOWER_BASIC_AUTH=admin:REPLACE_WITH_A_STRONG_PASSWORD

# CORE_LOG_LEVEL=INFO
# MAX_LOG_BODY_CHARS=2048
